<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#0A0B1E"
    android:padding="24dp">

    <!-- 1. Logo -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="50dp"
        android:background="#121330">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/my_logo"
            android:contentDescription="App Logo" />

    </FrameLayout>

    <!-- 2. Main Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ONLY FAIR HACKS"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ONLY FAIR HACKS"
        android:textColor="#A0A5C0"
        android:textSize="14sp" />

    <!-- 3. Activation Key -->
    <EditText
        android:id="@+id/edtKey"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/input_bg"
        android:hint="Activation Key"
        android:textColorHint="#5E6278"
        android:textColor="#FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:inputType="textPassword"
        android:textSize="16sp" />

    <!-- 4. Unlock Button -->
    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:text="UNLOCK PANEL"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:background="@drawable/button_gradient_bg" />

    <!-- 5. Generate Key Button -->
    <Button
        android:id="@+id/btnGenerate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="GENERATE KEY"
        android:textColor="#A0A5C0"
        android:textStyle="bold"
        android:textSize="15sp"
        android:background="@drawable/button_outline_bg" />

</LinearLayout>
